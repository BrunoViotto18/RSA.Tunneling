{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SHA256",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "cwd": "${workspaceFolder}/src/Viotto.Security.AuthSign/bin/Debug/net10.0",
      "program": "${workspaceFolder}/src/Viotto.Security.AuthSign/bin/Debug/net10.0/Viotto.Security.AuthSign.dll",
      "args": "${input:programArgs}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "programArgs",
      "type": "promptString",
      "description": "Program arguments",
      "default": "sign sample.txt"
    }
  ]
}
